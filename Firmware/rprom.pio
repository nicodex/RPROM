; pio_set_gpio_base(pio0, 0);
.define PUBLIC RPROM_DATA_PIN_BASE 0
.define PUBLIC RPROM_DATA_PIN_BITS 16
; pio_set_gpio_base(pio1, 16);
.define PUBLIC RPROM_ADDR_PIN_BASE RPROM_DATA_PIN_BITS
.define PUBLIC RPROM_ADDR_PIN_BITS 18
.define PUBLIC RPROM_BYTE_PIN (RPROM_ADDR_PIN_BASE + RPROM_ADDR_PIN_BITS)
.define PUBLIC RPROM_CE_PIN (RPROM_BYTE_PIN + 1)
.define PUBLIC RPROM_OE_PIN (RPROM_CE_PIN + 1)
.define PUBLIC RPROM_RESET_PIN (RPROM_OE_PIN + 1)

.pio_version 1
