#!/usr/bin/env fs-uae

[fs-uae]
amiga_model = A600
governor_warning = 0
kickstart_file = $CONFIG/testmenu.rom
save_states = 0
save_states_dir = $CONFIG/
screenshots_output_dir = $CONFIG/
screenshots_output_mask = 2
screenshots_output_prefix = testmenu
sub_title = testmenu
title = RPROM bootmenu
zoom = 640x512
