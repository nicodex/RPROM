	IFND	RPROM_FIRMWARE_VERSION_I
RPROM_FIRMWARE_VERSION_I	SET	1

RPROM_FIRMWARE_VERSION_MAJOR	EQU	@rprom_firmware_VERSION_MAJOR@
RPROM_FIRMWARE_VERSION_MINOR	EQU	@rprom_firmware_VERSION_MINOR@
RPROM_FIRMWARE_VERSION_PATCH	EQU	@rprom_firmware_VERSION_PATCH@

RPROM_FIRMWARE_VERSION	MACRO
	IFGT	RPROM_FIRMWARE_VERSION_MAJOR
		dc.b	'@rprom_project_VERSION@'
	ELSE
		dc.b	'?.?.?'
	ENDC
	ENDM

	ENDC
